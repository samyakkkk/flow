# slack-agent configuration. Copy to .env (never commit .env).

# Slack app credentials — created from slack-agent/manifest.json at api.slack.com/apps.
# Bot token: Install App → Bot User OAuth Token (xoxb-…)
SLACK_BOT_TOKEN=
# App-level token with connections:write (Basic Information → App-Level Tokens) — enables Socket Mode (xapp-…)
SLACK_APP_TOKEN=
# Only needed for HTTP mode instead of Socket Mode (public URL required):
# SLACK_SIGNING_SECRET=

# HTTP port for health/status (and /slack/events in HTTP mode).
SLACK_AGENT_PORT=80

# Answer runtime: "flow" (default — Flow's ask pipeline) or "echo" (smoke tests).
SLACK_AGENT_RUNTIME=flow

# Flow runtime: the project's orchestrator + admin bearer token.
FLOW_ORCHESTRATOR_URL=http://localhost:7500
FLOW_ADMIN_TOKEN=

# How long one question may take before giving up (default 300000 = 5min).
# SLACK_AGENT_ANSWER_TIMEOUT_MS=300000
