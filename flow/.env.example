# flow/.env.example — copy to .env and fill in real values.
# Never commit .env to version control.
# All variables are optional unless marked [REQUIRED].

# ── Authentication ────────────────────────────────────────────────────────────
# [REQUIRED] Bearer token for all orchestrator API endpoints.
# Generate with: openssl rand -hex 32
FLOW_ADMIN_TOKEN=

# ── LLM / OpenRouter ─────────────────────────────────────────────────────────
# [REQUIRED for classification and answer jobs]
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by the classifier (default: openrouter/minimax/minimax-m1)
CLASSIFIER_MODEL=

# Model used by the graph builder / enricher opencode jobs
GRAPH_BUILDER_MODEL=

# ── Graph (FalkorDB) ─────────────────────────────────────────────────────────
# Name of the FalkorDB graph to read/write (default: acme-v1)
GRAPH_NAME=acme-v1

# ── Gateway URL (set automatically in docker compose) ────────────────────────
# In host mode: http://localhost:7433
# In docker mode: set by compose to http://gateway:7433
# GATEWAY_URL=http://localhost:7433

# ── OpenCode integration ──────────────────────────────────────────────────────
# opencode CLI is NOT available inside Docker containers in v1.
# See deploy/local.md for hybrid mode (docker for infra, host for orchestrator).
#
# Set to 1 to replace real opencode with a deterministic fake (for testing/CI).
# Leave empty in production — real opencode will be spawned on index/answer jobs.
FLOW_FAKE_OPENCODE=

# Path to the index-workspace directory used by opencode agents.
# Only needed in host mode when running orchestrator outside Docker.
# OPENCODE_WORKSPACE_DIR=/path/to/flow/index-workspace

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create a Slack app with Socket Mode enabled.
# Bot Token Scopes: channels:history, groups:history, chat:write, users:read
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Slack channel ID for DM-style notification fallback
FLOW_DM_CHANNEL=

# ── Linear ───────────────────────────────────────────────────────────────────
# Personal access token or OAuth token from Linear workspace settings.
LINEAR_API_KEY=

# Signing secret used to verify Linear webhook payloads.
LINEAR_WEBHOOK_SECRET=

# Default team ID for ticket operations (found in Linear workspace settings).
LINEAR_DEFAULT_TEAM_ID=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT with contents:read and metadata:read on watched repos.
GITHUB_PAT=

# Secret set in the GitHub webhook configuration.
GITHUB_WEBHOOK_SECRET=

# Comma-separated list of repos to watch in local-poll mode.
# Format: owner/repo,owner/repo2
FLOW_WATCHED_REPOS=

# Polling interval in milliseconds for GitHub local-clone mode (default: 300000 = 5 min).
FLOW_GITHUB_POLL_MS=

# ── Fireflies (meeting transcripts) ──────────────────────────────────────────
FIREFLIES_API_KEY=

# ── Orchestrator tuning ───────────────────────────────────────────────────────
# Minimum classifier confidence to act (default: 0.6); lower = more aggressive.
FLOW_CONFIDENCE_FLOOR=

# Interval between drainer ticks in milliseconds (default: 2000).
FLOW_DRAIN_MS=

# Set to 1 to disable the drainer (outbox actions will not execute).
FLOW_DRAIN_DISABLE=

# Override the SQLite database path (default: data/flow.db, relative to orchestrator/).
# DB_PATH=data/flow.db

# Logging level: trace | debug | info | warn | error (default: info).
LOG_LEVEL=info

# Orchestrator HTTP port (default: 7500).
# ORCHESTRATOR_PORT=7500

# ── Verification flags ────────────────────────────────────────────────────────
# Set to 1 to run real integration tests in verify-all.sh (needs real creds above).
FLOW_VERIFY_REAL=

# Set to 1 in orchestrator tests to make classifier call the real LLM (slow).
FLOW_TEST_LIVE=
